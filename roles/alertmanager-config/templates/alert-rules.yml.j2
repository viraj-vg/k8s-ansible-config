apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: node-health
  namespace: {{ monitoring_namespace }}
  labels:
    release: {{ prometheus_release_label }}
spec:
  groups:
    - name: node-health
      rules:
        - alert: NodeExporterDown
          expr: up{job="node-exporter"} == 0
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "Node exporter is unavailable on {{ '{{' }} $labels.instance {{ '}}' }}"
        - alert: HighNodeCpu
          expr: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
          for: 10m
          labels:
            severity: warning
          annotations:
            summary: "Node CPU usage is above 85% on {{ '{{' }} $labels.instance {{ '}}' }}"
        - alert: LowNodeMemory
          expr: node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.10
          for: 10m
          labels:
            severity: warning
          annotations:
            summary: "Available node memory is below 10% on {{ '{{' }} $labels.instance {{ '}}' }}"
        - alert: PodMemoryHigh
          expr: |
            max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=~"staging|production", container!="", container!="POD"})
            /
            max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=~"staging|production", resource="memory"})
            > 0.8
          for: 2m
          labels:
            severity: critical
          annotations:
            summary: "Pod {{ '{{' }} $labels.pod {{ '}}' }} is using over 80% of its memory limit"
