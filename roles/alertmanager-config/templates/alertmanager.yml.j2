global:
  resolve_timeout: {{ alertmanager_resolve_timeout | to_json }}
route:
  receiver: slack
  group_by:
    - alertname
    - instance
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: slack
{% if alertmanager_slack_webhook_url not in ['', 'REPLACE_ME'] %}
    slack_configs:
      - api_url: {{ alertmanager_slack_webhook_url | to_json }}
        channel: {{ alertmanager_slack_channel | to_json }}
        send_resolved: true
        title: '{{ "{{" }} .CommonLabels.alertname {{ "}}" }}'
        text: '{{ "{{" }} .CommonAnnotations.summary {{ "}}" }}'
{% endif %}
